# PAZUZU-API v2.0 environment template.
# Copy to .env before running:  cp .env.example .env
# REAL API KEYS ARE NEVER COMMITTED. Keep secrets in your local .env only,
# or in the deployment secret store (Render / Vercel env vars).

# --- Real provider keys (optional; only used when PAZUZU_MOCK_PROVIDERS=false) ---
GROK_API_KEY=
GROK_API_BASE=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=

# --- Data stores (compose defaults) ---
DATABASE_URL=postgresql://pazuzu:pazuzu@localhost:5432/pazuzu
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me

# --- Dev mode: deterministic mock providers, no paid keys needed ---
PAZUZU_MOCK_PROVIDERS=true

# --- Logging ---
LOG_LEVEL=info
